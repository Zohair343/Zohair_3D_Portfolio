# Copy to backend/.env for local runs. Never commit the real .env.
APP_ENV=development              # production disables the dev-log email provider
PUBLIC_SITE_URL=https://example.com
ALLOWED_ORIGINS=                 # only needed if the frontend is on a different origin
TRUST_PROXY=false                # true behind a reverse proxy that sets X-Forwarded-For

# --- Ask Zohair (RAG) ---
GEMINI_API_KEY=REPLACE_ME                 # from Google AI Studio → Get API key
LLM_PROVIDER=gemini                       # gemini | anthropic
GEMINI_CHAT_MODEL=gemini-3.8-flash        # e.g. gemini-3.5-flash-lite for cheaper/faster
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite  # tried when the main model is busy (comma-separated)
EMBED_PROVIDER=gemini                     # gemini | local (local needs requirements-dev.txt)
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Narration voice for generate_narration.py (run --samples to audition)
NARRATION_VOICE=Charon
# Optional Claude provider (LLM_PROVIDER=anthropic):
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# CHAT_MODEL=claude-opus-5-5
CHAT_RATE_MAX=20
CHAT_RATE_WINDOW_S=600

# --- Contact form ---
CONTACT_TO_EMAIL=zohairishrat@gmail.com
MAIL_FROM=portfolio@your-verified-domain.example
EMAIL_PROVIDER=resend            # resend (recommended on Vercel) | smtp | dev-log (dev only)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls           # starttls | ssl
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
RESEND_API_KEY=re_REPLACE_ME
CONTACT_RATE_MAX=5                 # letters actually sent, per IP per window
CONTACT_ATTEMPT_MAX=30            # all attempts (incl. invalid), per IP per window
# --- Shared rate limiting on Vercel (optional; Upstash Redis REST) ---
UPSTASH_REDIS_REST_URL=https://REPLACE_ME.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME
CONTACT_RATE_WINDOW_S=3600
